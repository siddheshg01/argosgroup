# Copy to .env and set your Gemini API key locally. Never commit .env.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_TIMEOUT_SECONDS=45
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.25
# Optional; blank uses the general financial findings question.
POLICY_QUESTION=

# Optional SMTP settings, used only after a human approves an email action.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# Optional API protection for non-local deployments. Keep the value server-side.
FINOP_API_TOKEN=
FINOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
